          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="north"><static>true</static><pose>0 4 0.5 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>8 0.18 1.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>8 0.18 1.0</size></box></geometry><material><ambient>0.1 0.4 0.7 1</ambient><diffuse>0.1 0.4 0.7 1</diffuse></material></visual></link></model>
